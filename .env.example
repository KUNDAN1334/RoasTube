# Copy to .env.local and fill in. Without AUTH_GOOGLE_ID the dev server runs in demo mode
# (fixture roasts, no Google or Gemini calls).

# Auth.js: encrypts the session cookie. Generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=

# Google OAuth client (Web application). See README, "Google sign-in".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini API key from https://aistudio.google.com/apikey. Server-only.
GEMINI_API_KEY=

# Optional: 3 roasts per account per day. Leave empty to skip rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shown on the privacy policy and terms. Google's OAuth reviewers check it works.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: force demo mode on (1). Never turns on by itself in production.
ROASTUBE_DEMO=
